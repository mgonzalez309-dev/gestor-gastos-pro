// This is your Prisma schema file.
// Learn more about Prisma schemas at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADVISOR
}

enum Category {
  FOOD          // Alimentación
  TRANSPORT     // Transporte
  ENTERTAINMENT // Entretenimiento
  HEALTH        // Salud
  EDUCATION     // Educación
  CLOTHING      // Ropa e indumentaria
  TECHNOLOGY    // Tecnología
  HOME          // Hogar
  SERVICES      // Servicios
  OTHER         // Otros
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role          Role     @default(USER)
  currency      String   @default("ARS")
  age           Int?
  monthlyIncome Float?   @map("monthly_income")
  savingsGoal   Float?   @map("savings_goal")
  avatarUrl       String?  @map("avatar_url")
  categoryBudgets Json?    @map("category_budgets") // {"FOOD": 5000, "TRANSPORT": 2000, ...}
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  expenses               Expense[]
  tickets                Ticket[]
  receivedRecommendations Recommendation[] @relation("UserRecommendations")
  givenRecommendations    Recommendation[] @relation("AdvisorRecommendations")
  notifications          Notification[]
  savingsGoals           SavingsGoal[]

  @@map("users")
}

model Expense {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  merchant    String
  amount      Float
  category    Category @default(OTHER)
  date        DateTime
  description String?
  tags        String[] @default([])  // etiquetas personalizadas del usuario
  ticketId    String?  @map("ticket_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@map("expenses")
}

model Ticket {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  imageUrl       String    @map("image_url")
  extractedText  String?   @map("extracted_text")
  parsedAmount   Float?    @map("parsed_amount")
  parsedTax      Float?    @map("parsed_tax")
  parsedMerchant String?   @map("parsed_merchant")
  parsedItems    Json?     @map("parsed_items")
  parsedDate     DateTime? @map("parsed_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("tickets")
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  advisorId String?  @map("advisor_id")
  message   String
  type      String   @default("GENERAL") // GENERAL | ALERT | SAVING | PATTERN
  createdAt DateTime @default(now()) @map("created_at")

  user    User  @relation("UserRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  advisor User? @relation("AdvisorRecommendations", fields: [advisorId], references: [id])

  @@map("recommendations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // BUDGET_ALERT | UNUSUAL_EXPENSE | MONTHLY_GROWTH | SAVINGS_RISK | GENERAL
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?    // datos extra (categoría, monto, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Meta de ahorro con objetivo y plazo (distinto del User.savingsGoal simple,
// que es un monto mensual a reservar). Una SavingsGoal es algo como
// "Ahorrar $1.000.000 en 6 meses" con seguimiento de progreso propio.
model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  name          String                          // "Vacaciones", "Auto nuevo"
  targetAmount  Float     @map("target_amount")  // monto objetivo
  currentAmount Float     @default(0) @map("current_amount") // ahorrado hasta ahora hacia esta meta
  targetDate    DateTime? @map("target_date")    // fecha límite opcional
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}
